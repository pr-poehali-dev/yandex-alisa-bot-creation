{
  "tests": [
    {
      "name": "Register new user",
      "method": "POST",
      "path": "/?action=register",
      "body": {"username": "testauth99", "name": "Тест Auth", "bio": "", "password": "secret123"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Register duplicate username",
      "method": "POST",
      "path": "/?action=register",
      "body": {"username": "testauth99", "name": "Dup", "bio": "", "password": "secret123"},
      "expectedStatus": 409,
      "expectedBody": {"error": "Юзернейм уже занят"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"username": "testauth99", "password": "wrongpass"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Неверный пароль"},
      "bodyMatcher": "partial"
    }
  ]
}
