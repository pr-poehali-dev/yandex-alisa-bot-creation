{
  "tests": [
    {
      "name": "Register new user",
      "method": "POST",
      "path": "/?action=register",
      "body": {"username": "testauth99", "name": "Тест Auth", "bio": "", "password": "secret123"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Register duplicate username",
      "method": "POST",
      "path": "/?action=register",
      "body": {"username": "testauth99", "name": "Dup", "bio": "", "password": "secret123"},
      "expectedStatus": 409,
      "expectedBody": {"error": "Юзернейм уже занят"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"username": "testauth99", "password": "wrongpass"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Неверный пароль"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get blocked list empty",
      "method": "GET",
      "path": "/?action=get_blocked&username=testauth99",
      "expectedStatus": 200,
      "expectedBody": {"blocked": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get system notifications empty",
      "method": "GET",
      "path": "/?action=get_system_notifications&username=testauth99",
      "expectedStatus": 200,
      "expectedBody": {"notifications": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Mark system notifications read",
      "method": "POST",
      "path": "/?action=mark_system_notifications_read",
      "body": {"username": "testauth99"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Broadcast notification - no access",
      "method": "POST",
      "path": "/?action=broadcast_notification",
      "body": {"admin_username": "testauth99", "token": "fake", "text": "Test"},
      "expectedStatus": 403,
      "expectedBody": {"error": "Нет доступа"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Set VIP - no access",
      "method": "POST",
      "path": "/?action=set_vip",
      "body": {"admin_username": "testauth99", "token": "fake", "target_username": "someone", "vip": true},
      "expectedStatus": 403,
      "expectedBody": {"error": "Нет доступа"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Change username - not vip",
      "method": "POST",
      "path": "/?action=change_username",
      "body": {"username": "testauth99", "token": "fake", "new_username": "newtestname99"},
      "expectedStatus": 401,
      "expectedBody": {},
      "bodyMatcher": "partial"
    }
  ]
}