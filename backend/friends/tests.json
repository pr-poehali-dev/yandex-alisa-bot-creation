{
  "tests": [
    {
      "name": "Login correct password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"username": "testauth99", "password": "secret123"},
      "expectedStatus": 200,
      "expectedBody": {"username": "testauth99"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"username": "testauth99", "password": "wrongpass"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Неверный логин или пароль"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get blocked list",
      "method": "GET",
      "path": "/?action=get_blocked&username=testauth99",
      "expectedStatus": 200,
      "expectedBody": {"blocked": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get system notifications",
      "method": "GET",
      "path": "/?action=get_system_notifications&username=testauth99",
      "expectedStatus": 200,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "Mark notifications read",
      "method": "POST",
      "path": "/?action=mark_system_notifications_read",
      "body": {"username": "testauth99"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    }
  ]
}